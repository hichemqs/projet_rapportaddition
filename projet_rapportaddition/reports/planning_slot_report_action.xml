<?xml version="1.0" encoding="utf-8"?>
<odoo>


<record id="paperformat_ordre_mission" model="report.paperformat">
        <field name="name">Ordre de Mission</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
</record>

    
<record id="seq_mission_order" model="ir.sequence">
    <field name="name">Ordre de Mission</field>
    <field name="code">planning.slot</field>
    <field name="prefix">N°</field>
    <field name="suffix">-%(range_day)s/%(range_month)s-%(range_year)s</field>
    <field name="padding">3</field>
    <field name="use_date_range">True</field>
    <field name="number_next">1</field>
    <field name="number_increment">1</field>
    <field name="company_id" eval="False"/>
</record>



    
    <record id="action_report_planning_slot" model="ir.actions.report">
        <field name="name">Ordre De Mission Planning</field>
        <field name="model">planning.slot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">projet_rapportaddition.report_planning_slot_document</field>
        <field name="report_file">projet_rapportaddition.report_planning_slot_document</field>
    </record>
</odoo>