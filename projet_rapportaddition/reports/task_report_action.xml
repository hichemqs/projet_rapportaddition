<?xml version="1.0" encoding="utf-8"?>

<odoo>
<record id="seq_mission_order" model="ir.sequence">
    <field name="name">Ordre de Mission</field>
    <field name="code">project.task.mission.order</field>
    <field name="prefix">N°</field>
    <field name="suffix">-%(range_day)s/%(range_month)s-%(range_year)s</field>
    <field name="padding">3</field>
    <field name="use_date_range">True</field>
    <field name="number_next">1</field>
    <field name="number_increment">1</field>
    <field name="company_id" eval="False"/>
</record>

    <record id="action_report_task" model="ir.actions.report">
        <field name="name">Task Report</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">projet_rapportaddition.report_task_document</field>
        <field name="report_file">projet_rapportaddition.report_task_document</field>
    </record>

</odoo>